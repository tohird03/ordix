model Employee {
  id           String   @id @default(uuid()) @db.Uuid
  fullName     String
  phone        String   @unique
  passwordHash String
  isSuperadmin Boolean  @default(false)
  isActive     Boolean  @default(true)
  pages        String[] @default([])
  devices      Device[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
