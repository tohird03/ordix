model Product {
  id          String  @id @default(uuid())
  name        String
  description String? @db.Text
  image       String?

  count     Int @default(0)
  minAmount Int @default(0)

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  costPrice      Decimal  @db.Decimal(18, 2)
  costCurrencyId String
  costCurrency   Currency @relation("ProductCost", fields: [costCurrencyId], references: [id])

  salePrice      Decimal  @db.Decimal(18, 2)
  saleCurrencyId String
  saleCurrency   Currency @relation("ProductSale", fields: [saleCurrencyId], references: [id])

  wholesalePrice      Decimal  @db.Decimal(18, 2)
  wholesaleCurrencyId String
  wholesaleCurrency   Currency @relation("ProductWholesale", fields: [wholesaleCurrencyId], references: [id])

  lastSellingDate  DateTime?
  lastSellingPrice Decimal?  @db.Decimal(18, 2)
  lastSellingCount Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
}
