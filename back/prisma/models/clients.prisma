model Client {
  id              String    @id @default(uuid())
  fullname        String
  phone           String    @unique
  address         String?
  latitude        Float?
  longitude       Float?
  lastSellingDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  debtByCurrency ClientDebt[]

  @@index([fullname])
}

// Har bir (mijoz + valyuta) juftligi uchun bitta qator.
// Sotuv / to'lov / qaytaruv har safar shu yerdagi amount ni oshiradi yoki kamaytiradi.
model ClientDebt {
  id         String @id @default(uuid())
  clientId   String
  currencyId String
  amount     Int    @default(0)

  client   Client   @relation(fields: [clientId], references: [id])
  currency Currency @relation(fields: [currencyId], references: [id])

  @@unique([clientId, currencyId])
  @@index([currencyId])
}
