model Customer {
  id         String    @id @default(uuid())
  name       String    @db.VarChar(150)
  phone      String    @db.VarChar(20)
  address    String?
  lat        Float?
  lng        Float?
  debt       BigInt    @default(0)
  lastSaleAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([deletedAt, createdAt])
}
